# Server Configuration
PORT=3000
HOST=0.0.0.0

# WhatsApp Baileys Configuration
# Session directory path (will be created automatically if it doesn't exist)
WHATSAPP_SESSION_PATH=./auth_info

# WhatsApp Target Group IDs (comma-separated for multiple groups)
# Example: 120363023456789012@g.us,120363098765432101@g.us
# To find your group ID, start the bot, scan QR, and access GET /whatsapp/groups
WHATSAPP_GROUP_IDS=120xxxxxxxx@g.us

# GitHub Webhook Security
# The secret configured in your GitHub repository Webhook settings (Secret input)
# Leave empty only for development/testing without signature validation
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Logging Configuration (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# Message Queue & Rate Limiting (optional adjustments)
MESSAGE_RATE_LIMIT_MS=1000
MESSAGE_MAX_RETRIES=3
