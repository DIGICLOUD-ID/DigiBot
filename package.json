{
  "name": "github-webhook-whatsapp-bot",
  "version": "1.0.0",
  "description": "GitHub Webhook to WhatsApp Group Notification Bot using Baileys and Express",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/test-suite.ts"
  },
  "keywords": [
    "github",
    "webhook",
    "whatsapp",
    "baileys",
    "bot",
    "notification"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/qrcode-terminal": "^0.12.2",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "onlyBuiltDependencies": [
    "@whiskeysockets/baileys",
    "esbuild",
    "protobufjs"
  ]
}
